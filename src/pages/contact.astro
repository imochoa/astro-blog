---
import ContactCard from "@/components/contact/ContactCard.astro";
import BasicLayout from "@/layouts/BasicLayout.astro";
---

<BasicLayout title="Contact" description="Ways to get in touch with IMOchoa.">
  <section class="contact-page">
    <header class="page-header">
      <p class="eyebrow">Open channel</p>
      <h1>Let's talk.</h1>
      <p>Questions, corrections, memes... send them my way.</p>
    </header>

    <div class="contact-grid">
      <ContactCard
        href="mailto:blog@imochoa.com"
        label="Email"
        detail="blog@imochoa.com"
        icon="email"
      />
      <ContactCard
        href="https://github.com/imochoa"
        label="GitHub"
        detail="@imochoa"
        icon="github"
      />
      <ContactCard
        href="https://www.linkedin.com/in/imochoa/"
        label="LinkedIn"
        detail="in/imochoa"
        icon="linkedin"
      />
      <ContactCard
        href="https://ko-fi.com/imochoa"
        label="Ko-fi"
        detail="ko-fi.com/imochoa"
        icon="kofi"
      />
      <ContactCard
        href="https://www.paypal.com/paypalme/imochoa"
        label="PayPal"
        detail="paypal.me/imochoa"
        icon="paypal"
      />

      {
        /*
        Optional contact cards. Replace the placeholder values before uncommenting.

        <ContactCard
          href="https://bsky.app/profile/YOUR_HANDLE.bsky.social"
          label="Bluesky"
          detail="@YOUR_HANDLE.bsky.social"
          icon="link"
        />
        <ContactCard
          href="https://MASTODON_SERVER/@YOUR_HANDLE"
          label="Mastodon"
          detail="@YOUR_HANDLE@MASTODON_SERVER"
          icon="link"
        />
        <ContactCard
          href="https://www.instagram.com/YOUR_HANDLE/"
          label="Instagram"
          detail="@YOUR_HANDLE"
          icon="link"
        />
        <ContactCard
          href="https://x.com/YOUR_HANDLE"
          label="X / Twitter"
          detail="@YOUR_HANDLE"
          icon="link"
        />
        <ContactCard
          href="https://www.youtube.com/@YOUR_HANDLE"
          label="YouTube"
          detail="@YOUR_HANDLE"
          icon="link"
        />
        <ContactCard
          href="https://discord.com/users/YOUR_USER_ID"
          label="Discord"
          detail="YOUR_USERNAME"
          icon="link"
        />
        <ContactCard
          href="https://t.me/YOUR_HANDLE"
          label="Telegram"
          detail="@YOUR_HANDLE"
          icon="link"
        />
        <ContactCard
          href="https://signal.me/#eu/YOUR_SIGNAL_LINK"
          label="Signal"
          detail="YOUR_SIGNAL_USERNAME"
          icon="link"
        />
      */
      }
    </div>

    <p class="response-note">
      <span aria-hidden="true">*</span> I'll do my best to reply, but I can't make
      any promises 🙏
    </p>
  </section>
</BasicLayout>

<style>
  .contact-page {
    width: min(100%, 58rem);
    margin-inline: auto;
  }

  .page-header {
    max-width: 46rem;
    margin-bottom: var(--space-2xl);
  }

  .page-header p:last-child {
    font-size: 1.15rem;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-md);
  }

  .contact-grid > :global(:first-child) {
    grid-column: 1 / -1;
  }

  .response-note {
    margin-top: var(--space-xl);
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: 0.78rem;
  }

  .response-note span {
    color: var(--color-accent);
  }

  @media (max-width: 38rem) {
    .contact-grid {
      grid-template-columns: 1fr;
    }

    .contact-grid > :global(:first-child) {
      grid-column: auto;
    }
  }
</style>
