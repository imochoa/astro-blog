---
import { getEntry, render, type CollectionEntry } from "astro:content";
import FormattedDate from "@/components/FormattedDate.astro";
import PostNavigation from "@/components/PostNavigation.astro";
import TableOfContents from "@/components/TableOfContents.astro";
import BasicLayout from "@/layouts/BasicLayout.astro";
import { getPosts } from "@/lib/posts";

export async function getStaticPaths() {
  const posts = await getPosts();

  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<"posts">;
}

const { post } = Astro.props;
const rendered = await render(post);
const { Content } = rendered;
const mdxComponents = "components" in rendered ? rendered.components : {};
const tocHeadings = rendered.headings.filter(
  ({ depth }) => depth >= 2 && depth <= 3,
);
const tags = await Promise.all(post.data.tags.map((tag) => getEntry(tag)));
const tagNames = tags.flatMap((tag) => (tag ? [tag.data.name] : []));
const posts = await getPosts();
const postIndex = posts.findIndex(({ id }) => id === post.id);
const previous = posts[postIndex + 1];
const next = postIndex > 0 ? posts[postIndex - 1] : undefined;
const previousPage = previous ? `/blog/${previous.id}/` : undefined;
const nextPage = next ? `/blog/${next.id}/` : undefined;
---

<BasicLayout
  title={post.data.title}
  description={post.data.description}
  pageType="article"
  socialImage={post.data.socialImage}
  publishedAt={post.data.publishedAt}
  updatedAt={post.data.updatedAt}
  tags={tagNames}
  {previousPage}
  {nextPage}
>
  <article class="post" data-pagefind-body>
    <header class="page-header">
      <p class="post-dates">
        <FormattedDate date={post.data.publishedAt} label="Published" />
        {
          post.data.updatedAt && (
            <>
              <span aria-hidden="true"> · </span>
              <FormattedDate date={post.data.updatedAt} label="Updated" />
            </>
          )
        }
      </p>
      <h1 data-pagefind-meta="title">{post.data.title}</h1>
      <p>{post.data.description}</p>
      {
        tags.length > 0 && (
          <ul class="tag-list" role="list" aria-label="Tags">
            {tags.map(
              (tag) =>
                tag && (
                  <li>
                    <a class="tag" href={`/tags/${tag.id}/`}>
                      {tag.data.name}
                    </a>
                  </li>
                ),
            )}
          </ul>
        )
      }
    </header>

    <div class="post-body">
      {
        tocHeadings.length >= 2 && (
          <aside class="toc-column" data-pagefind-ignore>
            <TableOfContents headings={tocHeadings} />
          </aside>
        )
      }
      <div class="prose">
        <Content components={mdxComponents} />
      </div>
    </div>
  </article>

  <PostNavigation {previous} {next} />
</BasicLayout>
