---
import type { GetStaticPaths, Page } from "astro";
import BasicLayout from "@/layouts/BasicLayout.astro";
import Pagination from "@/components/blog/Pagination.astro";
import PostList from "@/components/blog/PostList.astro";
import { SITE } from "@/site-data";
import { getPosts, POSTS_PER_PAGE, type PostEntry } from "@/lib/posts";

export const getStaticPaths = (async ({ paginate }) => {
  const entries = await getPosts();

  return paginate(entries, { pageSize: POSTS_PER_PAGE }).filter(
    ({ props }) => props.page.currentPage > 1,
  );
}) satisfies GetStaticPaths;

interface Props {
  page: Page<PostEntry>;
}

const { page } = Astro.props;
const title = `Blog – Page ${page.currentPage}`;
const previousPage =
  page.currentPage === 2 ? "/blog/" : `/blog/page/${page.currentPage - 1}/`;
const nextPage =
  page.currentPage < page.lastPage
    ? `/blog/page/${page.currentPage + 1}/`
    : undefined;
---

<BasicLayout
  title={title}
  description={`Page ${page.currentPage} of posts from ${SITE.title}.`}
  {previousPage}
  {nextPage}
>
  <header class="page-header">
    <p class="eyebrow">Posts</p>
    <h1>Blog</h1>
    <p>Notes and ideas, newest first. Page {page.currentPage}.</p>
  </header>

  <PostList entries={page.data} />
  <Pagination currentPage={page.currentPage} totalPages={page.lastPage} />
</BasicLayout>
