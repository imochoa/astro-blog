---
import { getCollection } from "astro:content";
import BasicLayout from "@/layouts/BasicLayout.astro";
import { getFeedEntries } from "@/lib/posts";

const [tags, entries] = await Promise.all([
  getCollection("tags"),
  getFeedEntries(),
]);

const entryCounts = new Map<string, number>();
for (const entry of entries) {
  for (const tag of entry.data.tags) {
    entryCounts.set(tag.id, (entryCounts.get(tag.id) ?? 0) + 1);
  }
}

const usedTags = tags
  .filter((tag) => entryCounts.has(tag.id))
  .sort((a, b) => a.data.name.localeCompare(b.data.name));
---

<BasicLayout title="Tags" description="Browse entries by tag.">
  <header class="page-header">
    <p class="eyebrow">Topics</p>
    <h1>Tags</h1>
  </header>

  <ul class="tag-index" role="list">
    {
      usedTags.map((tag) => {
        const entryCount = entryCounts.get(tag.id) ?? 0;

        return (
          <li>
            <a class="tag-card" href={`/tags/${tag.id}/`}>
              <h2>{tag.data.name}</h2>
              {tag.data.description && <p>{tag.data.description}</p>}
              <small>
                {entryCount} {entryCount === 1 ? "entry" : "entries"}
              </small>
            </a>
          </li>
        );
      })
    }
  </ul>
</BasicLayout>
