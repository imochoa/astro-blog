---
import { getCollection } from "astro:content";
import BasicLayout from "@/layouts/BasicLayout.astro";
import { getPosts } from "@/lib/posts";

const [tags, posts] = await Promise.all([
  getCollection("tags"),
  getPosts(false),
]);

const postCounts = new Map<string, number>();
for (const post of posts) {
  for (const tag of post.data.tags) {
    postCounts.set(tag.id, (postCounts.get(tag.id) ?? 0) + 1);
  }
}

const usedTags = tags
  .filter((tag) => postCounts.has(tag.id))
  .sort((a, b) => a.data.name.localeCompare(b.data.name));
---

<BasicLayout title="Tags" description="Browse posts by tag.">
  <header class="page-header">
    <p class="eyebrow">Topics</p>
    <h1>Tags</h1>
  </header>

  <ul class="tag-index" role="list">
    {
      usedTags.map((tag) => {
        const postCount = postCounts.get(tag.id) ?? 0;

        return (
          <li>
            <a class="tag-card" href={`/tags/${tag.id}/`}>
              <h2>{tag.data.name}</h2>
              {tag.data.description && <p>{tag.data.description}</p>}
              <small>
                {postCount} {postCount === 1 ? "post" : "posts"}
              </small>
            </a>
          </li>
        );
      })
    }
  </ul>
</BasicLayout>
