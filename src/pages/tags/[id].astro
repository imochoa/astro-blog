---
import { getCollection, type CollectionEntry } from "astro:content";
import BasicLayout from "@/layouts/BasicLayout.astro";

export async function getStaticPaths() {
  const tags = await getCollection("tags");

  return tags.map((tag) => ({
    params: { id: tag.id },
    props: { tag },
  }));
}

interface Props {
  tag: CollectionEntry<"tags">;
}

const { tag } = Astro.props;
const posts = await getCollection(
  "posts",
  ({ data }) =>
    (import.meta.env.DEV || !data.draft) &&
    data.tags.some((postTag) => postTag.id === tag.id),
);

posts.sort(
  (a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf(),
);
---

<BasicLayout
  title={tag.data.name}
  description={tag.data.description ?? `Posts tagged ${tag.data.name}.`}
>
  <header class="page-header">
    <p class="eyebrow">Tag</p>
    <h1>{tag.data.name}</h1>
    {tag.data.description && <p>{tag.data.description}</p>}
  </header>

  {
    posts.length > 0 ? (
      <ol class="post-list" role="list">
        {posts.map((post) => (
          <li class="post-card">
            <article>
              <time datetime={post.data.publishedAt.toISOString()}>
                {post.data.publishedAt.toLocaleDateString("en", {
                  year: "numeric",
                  month: "long",
                  day: "numeric",
                })}
              </time>
              <h2>
                <a href={`/blog/${post.id}/`}>{post.data.title}</a>
              </h2>
              <p>{post.data.description}</p>
            </article>
          </li>
        ))}
      </ol>
    ) : (
      <p>No posts with this tag yet.</p>
    )
  }
</BasicLayout>
