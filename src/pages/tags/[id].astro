---
import { getCollection, type CollectionEntry } from "astro:content";
import PostList from "@/components/blog/PostList.astro";
import BasicLayout from "@/layouts/BasicLayout.astro";
import { getFeedEntries } from "@/lib/posts";

export async function getStaticPaths() {
  const tags = await getCollection("tags");

  return tags.map((tag) => ({
    params: { id: tag.id },
    props: { tag },
  }));
}

interface Props {
  tag: CollectionEntry<"tags">;
}

const { tag } = Astro.props;
const entries = (await getFeedEntries()).filter((entry) =>
  entry.data.tags.some((entryTag) => entryTag.id === tag.id),
);
---

<BasicLayout
  title={tag.data.name}
  description={tag.data.description ?? `Entries tagged ${tag.data.name}.`}
>
  <header class="page-header">
    <p class="eyebrow">Tag</p>
    <h1>{tag.data.name}</h1>
    {tag.data.description && <p>{tag.data.description}</p>}
  </header>

  <PostList
    {entries}
    emptyMessage="No posts, books, or videos with this tag yet."
  />
</BasicLayout>
