---
import { getCollection, type CollectionEntry } from "astro:content";
import PostList from "@/components/PostList.astro";
import BasicLayout from "@/layouts/BasicLayout.astro";
import { getPosts } from "@/lib/posts";

export async function getStaticPaths() {
  const tags = await getCollection("tags");

  return tags.map((tag) => ({
    params: { id: tag.id },
    props: { tag },
  }));
}

interface Props {
  tag: CollectionEntry<"tags">;
}

const { tag } = Astro.props;
const posts = (await getPosts()).filter((post) =>
  post.data.tags.some((postTag) => postTag.id === tag.id),
);
---

<BasicLayout
  title={tag.data.name}
  description={tag.data.description ?? `Posts tagged ${tag.data.name}.`}
>
  <header class="page-header">
    <p class="eyebrow">Tag</p>
    <h1>{tag.data.name}</h1>
    {tag.data.description && <p>{tag.data.description}</p>}
  </header>

  <PostList posts={posts} emptyMessage="No posts with this tag yet." />
</BasicLayout>
