<figure class="ascii-scene" aria-labelledby="ascii-scene-caption">
  <div class="ascii-stage">
    <pre data-ascii-art aria-hidden="true"></pre>
  </div>
  <figcaption id="ascii-scene-caption">
    <a
      href="https://ascii.co.uk/animated-art/3d-magic-animated-ascii-art-by-saidamagic.html"
      rel="external">“3D Magic” ASCII art</a
    >
    by
    <a href="https://www.instagram.com/saidamagic/" rel="author external"
      >saidamagic</a
    >
  </figcaption>
</figure>

<script>
  import packedFrames from "./3d-magic-frames.txt?raw";

  const art = document.querySelector<HTMLPreElement>("[data-ascii-art]");

  if (art) {
    const [initialFrame, ...deltas] = packedFrames.split("|");
    const characters = initialFrame.split("");
    const motionPreference = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    );
    const frameDuration = 40;
    let nextDelta = 0;
    let animationFrame = 0;
    let previousTime = 0;

    art.textContent = initialFrame;

    const advance = () => {
      if (nextDelta === deltas.length) {
        characters.splice(0, characters.length, ...initialFrame);
        nextDelta = 0;
      } else {
        const changes = deltas[nextDelta].split("~");

        for (let index = 0; index < changes.length; index += 2) {
          const start = Number.parseInt(changes[index], 36);
          const replacement = changes[index + 1];

          for (let offset = 0; offset < replacement.length; offset += 1) {
            characters[start + offset] = replacement[offset];
          }
        }

        nextDelta += 1;
      }

      art.textContent = characters.join("");
    };

    const animate = (time: number) => {
      if (time - previousTime >= frameDuration) {
        advance();
        previousTime = time;
      }

      animationFrame = window.requestAnimationFrame(animate);
    };

    const stop = () => {
      window.cancelAnimationFrame(animationFrame);
      animationFrame = 0;
    };

    const start = () => {
      if (animationFrame === 0 && !motionPreference.matches) {
        previousTime = performance.now();
        animationFrame = window.requestAnimationFrame(animate);
      }
    };

    const updateMotion = () => {
      if (motionPreference.matches) {
        stop();
      } else {
        start();
      }
    };

    motionPreference.addEventListener("change", updateMotion);
    window.addEventListener("pagehide", stop);
    window.addEventListener("pageshow", start);
    start();
  }
</script>

