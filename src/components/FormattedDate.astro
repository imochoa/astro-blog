---
interface Props {
  date: Date;
  label?: string;
}

const { date, label } = Astro.props;
const formattedDate = date.toLocaleDateString("en", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<time datetime={date.toISOString()}>
  {label && <span>{label} </span>}
  {formattedDate}
</time>
