---
interface Props {
  src: string;
  title: string;
  caption?: string;
}

const { src, title, caption } = Astro.props;
---

<figure class="lvgl-simulator" data-pagefind-ignore>
  <iframe
    src={src}
    title={title}
    loading="lazy"
    sandbox="allow-scripts allow-same-origin"></iframe>
  {
    caption && (
      <figcaption>
        <span>{caption}</span>
        <a href={src}>Open the simulator on its own page</a>
      </figcaption>
    )
  }
</figure>

<style>
  .lvgl-simulator {
    margin-inline: 0;
  }

  iframe {
    width: 100%;
    height: 21rem;
    display: block;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: #1a1a2e;
  }

  figcaption {
    margin-top: var(--space-xs);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-xs) var(--space-md);
    color: var(--color-muted);
    font-size: 0.85rem;
  }
</style>
