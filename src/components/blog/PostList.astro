---
import PostCard from "@/components/blog/PostCard.astro";
import type { FeedEntry } from "@/lib/posts";

interface Props {
  entries: FeedEntry[];
  emptyMessage?: string;
  showTags?: boolean;
}

const {
  entries,
  emptyMessage = "Nothing published yet.",
  showTags = true,
} = Astro.props;
---

{
  entries.length > 0 ? (
    <ol class="post-list" role="list">
      {entries.map((entry) => (
        <li>
          <PostCard {entry} {showTags} />
        </li>
      ))}
    </ol>
  ) : (
    <p>{emptyMessage}</p>
  )
}
