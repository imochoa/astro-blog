---
import type { CollectionEntry } from "astro:content";

interface Props {
  previous?: CollectionEntry<"posts">;
  next?: CollectionEntry<"posts">;
}

const { previous, next } = Astro.props;
---

{
  (previous || next) && (
    <nav
      class="post-navigation"
      aria-label="Post navigation"
      data-pagefind-ignore
    >
      {previous && (
        <a class="previous" href={`/blog/${previous.id}/`} rel="prev">
          <span>← Previous post</span>
          <strong>{previous.data.title}</strong>
        </a>
      )}
      {next && (
        <a class="next" href={`/blog/${next.id}/`} rel="next">
          <span>Next post →</span>
          <strong>{next.data.title}</strong>
        </a>
      )}
    </nav>
  )
}

<style>
  .post-navigation {
    width: min(100%, 48rem);
    margin: var(--space-xl) auto 0;
    padding-top: var(--space-lg);
    border-top: 1px solid var(--color-border);
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-md);
  }

  a {
    min-width: 0;
    display: grid;
    gap: var(--space-xs);
    padding: var(--space-md);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    color: var(--color-text);
    background: var(--color-surface);
    text-decoration: none;
  }

  a:hover {
    border-color: var(--color-accent);
  }

  span {
    color: var(--color-muted);
    font-size: 0.85rem;
  }

  strong {
    overflow-wrap: anywhere;
  }

  .next {
    grid-column: 2;
    text-align: right;
  }

  @media (max-width: 36rem) {
    .post-navigation {
      grid-template-columns: 1fr;
    }

    .next {
      grid-column: 1;
    }
  }
</style>
