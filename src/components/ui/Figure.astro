---
import { Image } from "astro:assets";

interface Props {
  alt: string;
  caption?: string;
  // ImageMetadata is provided globally by Astro's client types.
  // eslint-disable-next-line no-undef
  src: ImageMetadata;
}

const { alt, caption, src } = Astro.props;
const isSvg = src.format === "svg";

if (!caption && !Astro.slots.has("default")) {
  throw new Error("Figure requires a `caption` prop or default slot");
}

const figureStyle = `--figure-width: ${src.width}px; --figure-ratio: ${src.width} / ${src.height}`;
---

<figure class="zoomable-figure" data-zoomable-figure>
  <div class="figure-home" data-figure-home>
    <div class="figure-visual" data-figure-visual style={figureStyle}>
      {
        isSvg ? (
          <iframe
            src={src.src}
            title={alt}
            loading="lazy"
            sandbox="allow-same-origin"
            data-figure-frame
          />
        ) : (
          <Image src={src} alt={alt} />
        )
      }
    </div>
    <a
      class="zoom-button"
      href={src.src}
      target="_blank"
      rel="noopener noreferrer"
      aria-label={`Open a larger view of: ${alt}`}
      title="Open larger view"
      data-figure-open
    >
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <circle cx="11" cy="11" r="6"></circle>
        <path d="m16 16 4 4M8.5 11h5M11 8.5v5"></path>
      </svg>
    </a>
  </div>
  <figcaption><slot>{caption}</slot></figcaption>
</figure>

<dialog
  class="figure-dialog"
  aria-label={`Larger view of: ${alt}`}
  data-figure-dialog
>
  <div class="dialog-toolbar">
    <button type="button" data-figure-close>Close</button>
  </div>
  <div class="figure-stage" data-figure-stage></div>
</dialog>

<script>
  const figures = document.querySelectorAll<HTMLElement>(
    "[data-zoomable-figure]:not([data-figure-ready])",
  );

  for (const figure of figures) {
    figure.dataset.figureReady = "true";

    const home = figure.querySelector<HTMLElement>("[data-figure-home]");
    const visual = figure.querySelector<HTMLElement>("[data-figure-visual]");
    const openLink =
      figure.querySelector<HTMLAnchorElement>("[data-figure-open]");
    const frame = figure.querySelector<HTMLIFrameElement>(
      "[data-figure-frame]",
    );
    const dialog = figure.nextElementSibling;

    if (
      !home ||
      !visual ||
      !openLink ||
      !(dialog instanceof HTMLDialogElement)
    ) {
      continue;
    }

    const stage = dialog.querySelector<HTMLElement>("[data-figure-stage]");
    const closeButton = dialog.querySelector<HTMLButtonElement>(
      "[data-figure-close]",
    );

    if (!stage || !closeButton) continue;

    const open = () => {
      if (dialog.open) return;

      home.style.minHeight = `${home.getBoundingClientRect().height}px`;
      stage.append(visual);
      dialog.showModal();
      closeButton.focus();
    };

    const restore = () => {
      home.prepend(visual);
      home.style.removeProperty("min-height");
      openLink.focus();
    };

    const hasSelection = (selection: Selection | null, container: Node) =>
      Boolean(
        selection &&
        !selection.isCollapsed &&
        selection.anchorNode &&
        container.contains(selection.anchorNode),
      );

    openLink.addEventListener("click", (event) => {
      event.preventDefault();
      open();
    });
    closeButton.addEventListener("click", () => dialog.close());

    if (frame) {
      const attachFrameInteraction = () => {
        const frameDocument = frame.contentDocument;
        const frameWindow = frame.contentWindow;
        if (!frameDocument || !frameWindow) return;

        const root = frameDocument.documentElement;
        if (root.dataset.figureZoomReady) return;
        root.dataset.figureZoomReady = "true";
        root.style.width = "100%";
        root.style.height = "100%";
        root.style.cursor = "zoom-in";

        frameDocument.addEventListener("click", (event) => {
          const target = event.target;
          const link =
            target && "closest" in target
              ? (target as Element).closest("a")
              : null;
          if (link || hasSelection(frameWindow.getSelection(), root)) return;
          open();
        });
      };

      frame.addEventListener("load", attachFrameInteraction);
      attachFrameInteraction();
    } else {
      visual.addEventListener("click", (event) => {
        const target = event.target;
        if (target instanceof Element && target.closest("a")) return;
        if (hasSelection(window.getSelection(), visual)) return;
        open();
      });
    }

    dialog.addEventListener("click", (event) => {
      if (event.target === dialog) dialog.close();
    });
    dialog.addEventListener("close", restore);
  }
</script>

<style>
  .zoomable-figure {
    margin-inline: 0;
  }

  .figure-home {
    position: relative;
  }

  .figure-visual {
    max-width: 100%;
    margin-inline: auto;
    cursor: zoom-in;
  }

  .figure-home .figure-visual :global(img),
  .figure-home .figure-visual iframe {
    display: block;
    width: 100%;
    max-width: 100%;
    height: auto;
    aspect-ratio: var(--figure-ratio);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
  }

  .zoom-button {
    position: absolute;
    top: var(--space-xs);
    right: var(--space-xs);
    width: 2.5rem;
    height: 2.5rem;
    display: grid;
    place-items: center;
    padding: 0;
    border: 1px solid var(--color-border-strong);
    border-radius: 50%;
    color: var(--color-text);
    background: color-mix(in srgb, var(--color-surface) 90%, transparent);
    box-shadow: var(--shadow-sm);
    cursor: zoom-in;
    backdrop-filter: blur(0.25rem);
  }

  .zoom-button:hover {
    color: var(--color-accent);
  }

  .zoom-button:focus-visible,
  .dialog-toolbar button:focus-visible {
    outline: 3px solid var(--color-accent);
    outline-offset: 2px;
  }

  .zoom-button svg {
    width: 1.25rem;
    height: 1.25rem;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-width: 1.8;
  }

  .figure-dialog {
    width: calc(100vw - 2rem);
    max-width: none;
    height: calc(100dvh - 2rem);
    max-height: none;
    margin: auto;
    padding: var(--space-sm);
    grid-template-rows: auto minmax(0, 1fr);
    gap: var(--space-sm);
    overflow: hidden;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-lg);
    color: var(--color-text);
    background: var(--color-background);
    box-shadow: var(--shadow-lg);
  }

  .figure-dialog[open] {
    display: grid;
  }

  .figure-dialog::backdrop {
    background: rgb(11 17 29 / 78%);
    backdrop-filter: blur(0.2rem);
  }

  .dialog-toolbar {
    display: flex;
    justify-content: end;
  }

  .dialog-toolbar button {
    padding: 0.45rem var(--space-sm);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius);
    color: var(--color-text);
    background: var(--color-surface);
    font-weight: 700;
    cursor: pointer;
  }

  .figure-stage {
    min-width: 0;
    min-height: 0;
    overflow: auto;
    border-radius: var(--radius);
    background: var(--color-surface);
  }

  .figure-stage .figure-visual {
    width: var(--figure-width);
    max-width: none;
    cursor: default;
  }

  .figure-stage .figure-visual :global(img),
  .figure-stage .figure-visual iframe {
    display: block;
    width: 100%;
    max-width: none;
    height: auto;
    aspect-ratio: var(--figure-ratio);
  }

  @media (max-width: 40rem) {
    .figure-dialog {
      width: 100vw;
      height: 100dvh;
      border: 0;
      border-radius: 0;
    }
  }
</style>
