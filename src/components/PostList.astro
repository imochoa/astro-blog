---
import { getCollection, type CollectionEntry } from "astro:content";

interface Props {
  posts: CollectionEntry<"posts">[];
}

const { posts } = Astro.props;
const tags = await getCollection("tags");
const tagsById = new Map(tags.map((tag) => [tag.id, tag.data.name]));
---

{
  posts.length > 0 ? (
    <ol class="post-list" role="list">
      {posts.map((post) => (
        <li class="post-card">
          <article>
            <time datetime={post.data.publishedAt.toISOString()}>
              {post.data.publishedAt.toLocaleDateString("en", {
                year: "numeric",
                month: "long",
                day: "numeric",
              })}
            </time>
            <h2>
              <a href={`/blog/${post.id}/`}>{post.data.title}</a>
            </h2>
            <p>{post.data.description}</p>
            {post.data.tags.length > 0 && (
              <ul class="tag-list" role="list" aria-label="Tags">
                {post.data.tags.map((tag) => (
                  <li>
                    <a class="tag" href={`/tags/${tag.id}/`}>
                      {tagsById.get(tag.id) ?? tag.id}
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </article>
        </li>
      ))}
    </ol>
  ) : (
    <p>No posts yet.</p>
  )
}
