---
import type { CollectionEntry } from "astro:content";
import PostCard from "@/components/PostCard.astro";

interface Props {
  posts: CollectionEntry<"posts">[];
  emptyMessage?: string;
  showTags?: boolean;
}

const { posts, emptyMessage = "No posts yet.", showTags = true } = Astro.props;
---

{
  posts.length > 0 ? (
    <ol class="post-list" role="list">
      {posts.map((post) => (
        <li>
          <PostCard {post} {showTags} />
        </li>
      ))}
    </ol>
  ) : (
    <p>{emptyMessage}</p>
  )
}
