---
interface Props {
  currentPage: number;
  totalPages: number;
}

const { currentPage, totalPages } = Astro.props;
const pageURL = (page: number) =>
  page === 1 ? "/blog/" : `/blog/page/${page}/`;
---

{
  totalPages > 1 && (
    <nav class="pagination" aria-label="Blog pages">
      <a
        class:list={["pagination-step", { disabled: currentPage === 1 }]}
        href={currentPage > 1 ? pageURL(currentPage - 1) : undefined}
        aria-disabled={currentPage === 1 ? "true" : undefined}
      >
        Previous
      </a>

      <ol role="list">
        {Array.from({ length: totalPages }, (_, index) => index + 1).map(
          (page) => (
            <li>
              <a
                href={pageURL(page)}
                aria-current={page === currentPage ? "page" : undefined}
                aria-label={`Page ${page}`}
              >
                {page}
              </a>
            </li>
          ),
        )}
      </ol>

      <a
        class:list={[
          "pagination-step",
          { disabled: currentPage === totalPages },
        ]}
        href={currentPage < totalPages ? pageURL(currentPage + 1) : undefined}
        aria-disabled={currentPage === totalPages ? "true" : undefined}
      >
        Next
      </a>
    </nav>
  )
}

<style>
  .pagination {
    margin-top: var(--space-xl);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-md);
  }

  ol {
    display: flex;
    gap: var(--space-xs);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  a {
    min-width: 2.5rem;
    min-height: 2.5rem;
    display: inline-grid;
    place-items: center;
    padding-inline: var(--space-sm);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    color: var(--color-text);
    background: var(--color-surface);
    text-decoration: none;
  }

  a:hover,
  a[aria-current="page"] {
    border-color: var(--color-accent);
    color: var(--color-on-accent);
    background: var(--color-accent);
  }

  .disabled {
    visibility: hidden;
  }

  @media (max-width: 32rem) {
    .pagination {
      gap: var(--space-xs);
    }

    .pagination-step {
      font-size: 0;
    }

    .pagination-step:first-child::after {
      content: "←";
      font-size: 1rem;
    }

    .pagination-step:last-child::after {
      content: "→";
      font-size: 1rem;
    }
  }
</style>
