---
import PagefindConfig from "astro-pagefind/components/PagefindConfig.astro";

const links = [
  { href: "/", label: "Home" },
  { href: "/blog/", label: "Blog" },
  { href: "/tags/", label: "Tags" },
];

const pathname = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/" ? pathname === href : pathname.startsWith(href);
---

<header class="site-header">
  <nav class="container" aria-label="Primary navigation">
    <a class="site-name" href="/">astro-blog</a>
    <ul role="list">
      {
        links.map(({ href, label }) => (
          <li>
            <a href={href} aria-current={isActive(href) ? "page" : undefined}>
              {label}
            </a>
          </li>
        ))
      }
    </ul>
    <div class="site-search">
      <PagefindConfig instance="site-search" lang="en" />
      <pagefind-searchbox
        instance="site-search"
        placeholder="Search posts"
        max-results="6"
        show-sub-results></pagefind-searchbox>
    </div>
    <button
      class="theme-toggle"
      type="button"
      aria-label="Switch to dark theme"
      aria-pressed="false"
      data-theme-toggle
    >
      <svg
        class="theme-icon theme-icon-moon"
        viewBox="0 0 24 24"
        aria-hidden="true"
      >
        <path d="M20.4 15.2A8.5 8.5 0 0 1 8.8 3.6 8.5 8.5 0 1 0 20.4 15.2Z"
        ></path>
      </svg>
      <svg
        class="theme-icon theme-icon-sun"
        viewBox="0 0 24 24"
        aria-hidden="true"
      >
        <circle cx="12" cy="12" r="3.5"></circle>
        <path
          d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
        ></path>
      </svg>
      <span class="visually-hidden" data-theme-label>Switch to dark theme</span>
    </button>
  </nav>
</header>

<script>
  const button = document.querySelector<HTMLButtonElement>(
    "[data-theme-toggle]",
  );
  const label = button?.querySelector<HTMLElement>("[data-theme-label]");

  const updateToggle = (theme: "light" | "dark") => {
    const dark = theme === "dark";
    const nextLabel = `Switch to ${dark ? "light" : "dark"} theme`;

    button?.setAttribute("aria-pressed", String(dark));
    button?.setAttribute("aria-label", nextLabel);
    button?.setAttribute("title", nextLabel);
    if (label) label.textContent = nextLabel;
  };

  const setTheme = (theme: "light" | "dark") => {
    document.documentElement.dataset.theme = theme;
    document
      .querySelector("#theme-color")
      ?.setAttribute("content", theme === "dark" ? "#111714" : "#f6f8f7");
    updateToggle(theme);

    try {
      localStorage.setItem("theme", theme);
    } catch {
      // The selected theme still applies for this page when storage is blocked.
    }
  };

  const currentTheme =
    document.documentElement.dataset.theme === "dark" ? "dark" : "light";
  updateToggle(currentTheme);

  button?.addEventListener("click", () => {
    const theme =
      document.documentElement.dataset.theme === "dark" ? "light" : "dark";
    setTheme(theme);
  });
</script>

<style>
  .site-header {
    border-bottom: 1px solid var(--color-border);
    background: var(--color-surface);
  }

  nav {
    min-height: 4rem;
    display: grid;
    grid-template-columns: auto 1fr minmax(14rem, 20rem) auto;
    align-items: center;
    gap: var(--space-md);
  }

  .site-name {
    color: var(--color-text);
    font-weight: 700;
    text-decoration: none;
  }

  ul {
    display: flex;
    justify-self: end;
    gap: var(--space-md);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  ul a {
    color: var(--color-muted);
    text-decoration: none;
  }

  ul a:hover,
  ul a[aria-current="page"] {
    color: var(--color-accent);
  }

  .site-search {
    --pf-background: var(--color-surface);
    --pf-border: var(--color-border);
    --pf-border-focus: var(--color-accent);
    --pf-border-radius: var(--radius);
    --pf-font: var(--font-sans);
    --pf-input-height: 2.5rem;
    --pf-mark: var(--color-accent-soft);
    --pf-searchbox-max-width: 20rem;
    --pf-text: var(--color-text);
    --pf-text-muted: var(--color-muted);
    width: 100%;
  }

  pagefind-searchbox {
    display: block;
  }

  .theme-toggle {
    width: 2.5rem;
    height: 2.5rem;
    display: inline-grid;
    place-items: center;
    padding: 0;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    color: var(--color-muted);
    background: var(--color-surface);
    cursor: pointer;
  }

  .theme-toggle:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
    background: var(--color-accent-soft);
  }

  .theme-icon {
    width: 1.15rem;
    height: 1.15rem;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.8;
  }

  .theme-icon-moon {
    fill: currentColor;
    stroke: none;
  }

  .theme-icon-sun {
    display: none;
  }

  :global(:root[data-theme="dark"]) .theme-icon-moon {
    display: none;
  }

  :global(:root[data-theme="dark"]) .theme-icon-sun {
    display: block;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    clip-path: inset(50%);
    white-space: nowrap;
  }

  @media (max-width: 48rem) {
    nav {
      grid-template-columns: auto 1fr auto;
      padding-block: var(--space-sm);
    }

    .site-search {
      grid-column: 1 / -1;
      --pf-searchbox-max-width: none;
    }
  }
</style>
