{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist", "public/embeds/lvgl"],
  "compilerOptions": {
    "allowArbitraryExtensions": true,
    "paths": {
      "@/*": ["./src/*"],
      "@/ui/*": ["./src/components/ui/*"],
      "@posts/*": ["./src/content/posts/*"]
    }
    // "jsx": "react-jsx",
    // "jsxImportSource": "react"
  }
}
