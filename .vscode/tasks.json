{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Dev Container: Create or start",
      "type": "shell",
      "command": "just",
      "args": ["up"],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Blog: Start development server",
      "type": "shell",
      "command": "just",
      "args": ["dev"],
      "isBackground": true,
      "problemMatcher": {
        "owner": "astro",
        "pattern": {
          "regexp": "^(ASTRO_DIAGNOSTIC):(\\d+):(.*)$",
          "file": 1,
          "line": 2,
          "message": 3
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "\\$ astro dev",
          "endsPattern": "ready in [0-9]+ ms"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Blog: Build",
      "type": "shell",
      "command": "just",
      "args": ["build"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "Blog: Check internal links",
      "type": "shell",
      "command": "just",
      "args": ["check-links"],
      "problemMatcher": []
    },
    {
      "label": "Blog: Run CI",
      "type": "shell",
      "command": "just",
      "args": ["ci"],
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": []
    }
  ]
}
