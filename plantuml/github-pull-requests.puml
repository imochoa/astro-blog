' GitHub pull-request and referenced Jira-ticket diagram helpers.
'
' Pull-request specs may be fully qualified (owner/repo#42), relative to the
' default owner (repo#42), or relative to both defaults (#42).

!if %not(%variable_exists("$GHPR_LIBRARY_LOADED"))
!global $GHPR_LIBRARY_LOADED = %true()
!global $GHPR_DEFAULT_OWNER = ""
!global $GHPR_DEFAULT_REPO = ""
!global $GHPR_COUNTER = 0
!global $GHPR_LAST_ID = ""

skinparam shadowing false
skinparam package {
  BackgroundColor<<ghpr-owner>> #F8FAFC
  BorderColor<<ghpr-owner>> #64748B
  FontColor<<ghpr-owner>> #0F172A
  BackgroundColor<<ghpr-repository>> #FFFFFF
  BorderColor<<ghpr-repository>> #94A3B8
  FontColor<<ghpr-repository>> #0F172A
  BackgroundColor<<ghpr-fork>> #FFF7ED
  BorderColor<<ghpr-fork>> #F97316
  FontColor<<ghpr-fork>> #7C2D12
  BackgroundColor<<ghpr-jira-container>> #FAF5FF
  BorderColor<<ghpr-jira-container>> #9333EA
  FontColor<<ghpr-jira-container>> #581C87
}
skinparam rectangle {
  RoundCorner 10
  BackgroundColor<<ghpr-branch>> #F1F5F9
  BorderColor<<ghpr-branch>> #64748B
  FontColor<<ghpr-branch>> #0F172A
  BackgroundColor<<ghpr-pr-open>> #DBEAFE
  BorderColor<<ghpr-pr-open>> #2563EB
  FontColor<<ghpr-pr-open>> #1E3A8A
  BackgroundColor<<ghpr-pr-draft>> #F1F5F9
  BorderColor<<ghpr-pr-draft>> #64748B
  FontColor<<ghpr-pr-draft>> #334155
  BackgroundColor<<ghpr-pr-approved>> #DCFCE7
  BorderColor<<ghpr-pr-approved>> #16A34A
  FontColor<<ghpr-pr-approved>> #14532D
  BackgroundColor<<ghpr-pr-changes-requested>> #FEE2E2
  BorderColor<<ghpr-pr-changes-requested>> #DC2626
  FontColor<<ghpr-pr-changes-requested>> #7F1D1D
  BackgroundColor<<ghpr-pr-review-required>> #FEF3C7
  BorderColor<<ghpr-pr-review-required>> #D97706
  FontColor<<ghpr-pr-review-required>> #78350F
}
skinparam card {
  RoundCorner 12
  BackgroundColor<<ghpr-jira-referenced>> #F3E8FF
  BorderColor<<ghpr-jira-referenced>> #9333EA
  FontColor<<ghpr-jira-referenced>> #581C87
}

!procedure $GHPR_DEFAULTS($owner, $repository="")
!global $GHPR_DEFAULT_OWNER = $owner
!global $GHPR_DEFAULT_REPO = $repository
!endprocedure

!function $GHPR_BEFORE($text, $delimiter)
!local $position = %strpos($text, $delimiter)
!if $position < 0
!return $text
!endif
!return %substr($text, 0, $position)
!endfunction

!function $GHPR_AFTER($text, $delimiter)
!local $position = %strpos($text, $delimiter)
!if $position < 0
!return ""
!endif
!return %substr($text, $position + %strlen($delimiter))
!endfunction

!function $GHPR_REPO_OWNER($spec)
!local $slash = %strpos($spec, "/")
!if $slash >= 0
!return %substr($spec, 0, $slash)
!endif
!return $GHPR_DEFAULT_OWNER
!endfunction

!function $GHPR_REPO_NAME($spec)
!local $slash = %strpos($spec, "/")
!if $slash >= 0
!return %substr($spec, $slash + 1)
!endif
!if $spec == ""
!return $GHPR_DEFAULT_REPO
!endif
!return $spec
!endfunction

!function $GHPR_PR_OWNER($spec)
!local $hash = %strpos($spec, "#")
!if $hash < 0
!return $GHPR_DEFAULT_OWNER
!endif
!local $repository = %substr($spec, 0, $hash)
!return $GHPR_REPO_OWNER($repository)
!endfunction

!function $GHPR_PR_REPO($spec)
!local $hash = %strpos($spec, "#")
!if $hash < 0
!return $GHPR_DEFAULT_REPO
!endif
!local $repository = %substr($spec, 0, $hash)
!return $GHPR_REPO_NAME($repository)
!endfunction

!function $GHPR_PR_NUMBER($spec)
!local $number = $GHPR_AFTER($spec, "#")
!if $number == ""
!return $spec
!endif
!return $number
!endfunction

!function $GHPR_BRANCH_OWNER($spec)
!local $colon = %strpos($spec, ":")
!if $colon < 0
!return $GHPR_DEFAULT_OWNER
!endif
!local $repository = %substr($spec, 0, $colon)
!return $GHPR_REPO_OWNER($repository)
!endfunction

!function $GHPR_BRANCH_REPO($spec)
!local $colon = %strpos($spec, ":")
!if $colon < 0
!return $GHPR_DEFAULT_REPO
!endif
!local $repository = %substr($spec, 0, $colon)
!return $GHPR_REPO_NAME($repository)
!endfunction

!function $GHPR_BRANCH_NAME($spec)
!local $branch = $GHPR_AFTER($spec, ":")
!if $branch == ""
!return $spec
!endif
!return $branch
!endfunction

!function $GHPR_NEXT_ID($prefix)
!global $GHPR_COUNTER = $GHPR_COUNTER + 1
!return $prefix + %string($GHPR_COUNTER)
!endfunction

!procedure $GHPR_OWNER_BEGIN($owner, $kind="organization", $alias="")
!local $id = $alias
!if $id == ""
!$id = $GHPR_NEXT_ID("ghpr_owner_")
!endif
!global $GHPR_LAST_ID = $id
package "<b>$owner</b>\n<size:10>$kind</size>" as $id <<ghpr-owner>> {
!endprocedure

!procedure $GHPR_REPO_BEGIN($spec="", $alias="", $forkOf="")
!local $owner = $GHPR_REPO_OWNER($spec)
!local $repository = $GHPR_REPO_NAME($spec)
!assert ($owner != "") && ($repository != "") : "Repository specs need an owner and repository"
!local $id = $alias
!if $id == ""
!$id = $GHPR_NEXT_ID("ghpr_repo_")
!endif
!global $GHPR_LAST_ID = $id
!if $forkOf == ""
package "<b>$repository</b>" as $id <<ghpr-repository>> {
!else
package "<b>$repository</b>\n<size:10>fork of $forkOf</size>" as $id <<ghpr-fork>> {
!endif
!endprocedure

!procedure $GHPR_END()
}
!endprocedure

!procedure $GHPR_JIRA_BEGIN($label="Jira", $alias="")
!local $id = $alias
!if $id == ""
!$id = $GHPR_NEXT_ID("ghpr_jira_container_")
!endif
!global $GHPR_LAST_ID = $id
package "<b>$label</b>\n<size:10>referenced tickets</size>" as $id <<ghpr-jira-container>> {
!endprocedure

!procedure $GHPR_BRANCH($spec, $alias="", $role="branch")
!local $owner = $GHPR_BRANCH_OWNER($spec)
!local $repository = $GHPR_BRANCH_REPO($spec)
!local $branch = $GHPR_BRANCH_NAME($spec)
!assert ($owner != "") && ($repository != "") && ($branch != "") : "Branch specs need an owner, repository, and branch"
!local $id = $alias
!if $id == ""
!$id = $GHPR_NEXT_ID("ghpr_branch_")
!endif
!global $GHPR_LAST_ID = $id
rectangle "<size:10>$role</size>\n<b>$branch</b>" as $id <<ghpr-branch>>
!endprocedure

!procedure $GHPR_PR($spec, $title="", $head="", $base="", $status="open", $alias="", $tooltip="", $compact=%false())
!local $owner = $GHPR_PR_OWNER($spec)
!local $repository = $GHPR_PR_REPO($spec)
!local $number = $GHPR_PR_NUMBER($spec)
!assert ($owner != "") && ($repository != "") && ($number != "") : "Pull-request specs need an owner, repository, and number"
!local $id = $alias
!if $id == ""
!$id = $GHPR_NEXT_ID("ghpr_pr_")
!endif
!global $GHPR_LAST_ID = $id
!local $url = "https://github.com/" + $owner + "/" + $repository + "/pull/" + $number
!local $details = $tooltip
!if $details == ""
!$details = "PR #" + $number
!if $title != ""
!$details = $details + "\n" + $title
!endif
!if ($head != "") || ($base != "")
!$details = $details + "\n" + $head + " -> " + $base
!endif
!endif
!local $label = "<b>[[" + $url + "{" + $details + "} PR #" + $number + "]]</b>"
!if %not($compact)
!if $title != ""
!$label = $label + "\n" + $title
!endif
!if ($head != "") || ($base != "")
!$label = $label + "\n<size:10>" + $head + " -> " + $base + "</size>"
!endif
!endif
rectangle "$label" as $id <<ghpr-pr-$status>>
!endprocedure

!procedure $GHPR_JIRA($key, $summary="", $url="", $tooltip="", $alias="", $compact=%true())
!assert $key != "" : "Jira tickets need an issue key"
!local $id = $alias
!if $id == ""
!$id = $GHPR_NEXT_ID("ghpr_jira_")
!endif
!global $GHPR_LAST_ID = $id
!local $details = $tooltip
!if $details == ""
!$details = "Jira ticket " + $key
!if $summary != ""
!$details = $details + "\n" + $summary
!endif
!endif
!local $target = ""
!if $url != ""
!$target = $url
!endif
!$target = $target + "{" + $details + "}"
!local $label = "<b>[[" + $target + " " + $key + "]]</b>"
!if %not($compact)
!if $summary != ""
!$label = $label + "\n" + $summary
!endif
!endif
card "$label" as $id <<ghpr-jira-referenced>>
!endprocedure

!procedure $GHPR_OPENS($branch, $pullRequest)
$branch -[#64748B]-> $pullRequest : opens
!endprocedure

!procedure $GHPR_TARGETS($pullRequest, $branch)
$pullRequest ..[#94A3B8]> $branch : targets
!endprocedure

!procedure $GHPR_STACK($lower, $upper, $kind="stacked")
$lower -[#7C3AED,bold]-> $upper : $kind
!endprocedure

!procedure $GHPR_FORK($fork, $upstream)
$fork ..[#F97316]> $upstream : fork of
!endprocedure

!procedure $GHPR_REFERENCES($pullRequest, $jira)
$pullRequest ..[#9333EA]> $jira : references
!endprocedure

!procedure $GHPR_LEGEND()
legend bottom left
  |= Shape |= Meaning |
  | <#F1F5F9> branch | Git branch |
  | <#DBEAFE> open | Open pull request |
  | <#F1F5F9> draft | Draft pull request |
  | <#DCFCE7> approved | Approved pull request |
  | <#FEF3C7> review required | Waiting for review |
  | <#FEE2E2> changes requested | Changes requested |
  | <#F3E8FF> Jira card | Referenced Jira ticket |
  | <color:#7C3AED>solid arrow</color> | Pull-request stack |
  | <color:#F97316>dotted arrow</color> | Repository fork |
  | <color:#9333EA>dotted arrow</color> | Jira reference |
endlegend
!endprocedure

!endif
